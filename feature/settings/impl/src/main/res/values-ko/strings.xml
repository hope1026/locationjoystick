    <string name="settings_hub_roaming">자유 이동</string>
    <string name="settings_hub_roaming_desc">임의로 걸을 때 사용할 기본 영역, 거리, 속도, 경로 방식을 설정합니다.</string>
    <string name="settings_favorites_routes_title">즐겨찾기 및 경로</string>
    <string name="settings_favorites_routes_favorites">즐겨찾기</string>
    <string name="settings_favorites_routes_options_for_the_favorites_list">즐겨찾기 목록을 설정합니다.</string>
    <string name="settings_favorites_routes_show_hot_locations">추천 장소 표시</string>
    <string name="settings_favorites_routes_show_hot_locations_desc">추천하는 인기 장소를 즐겨찾기에 추가합니다. 아래에서 추가할 장소를 선택하세요.</string>
