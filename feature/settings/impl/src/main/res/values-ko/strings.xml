    <string name="settings_gps_unit_mph">mph</string>
    <string name="settings_gps_speed_exceeds_8_m_s_may">속도가 8 m/s를 초과하면 일부 게임의 부정행위 방지 기능이 작동할 수 있습니다</string>
    <string name="settings_gps_movement_and_gps">이동 및 GPS</string>
    <string name="settings_gps_remember_last_location">마지막 위치 기억</string>
    <string name="settings_gps_remember_last_location_desc">앱을 다시 시작하면 마지막으로 설정한 위치를 복원합니다.</string>
    <string name="settings_menus_appearance">화면 모양</string>
    <string name="settings_menus_switch_to_a_light_theme_for">밝거나 햇빛이 강한 곳에서 보기 편하도록 밝은 테마로 전환합니다.</string>
    <string name="settings_menus_light_mode">라이트 모드</string>
    <string name="settings_menus_map_section">지도</string>
    <string name="settings_menus_map_source_desc">지도 화면, 플로팅 지도, 즐겨찾기 위치 선택, 경로 만들기에서 사용할 지도 타일을 선택합니다. 저장한 위치와 모의 GPS 좌표는 바뀌지 않습니다.</string>
    <string name="settings_menus_geocoding_section">장소 검색</string>
    <string name="settings_menus_geocoding_desc">장소와 주소를 조회할 서비스를 선택합니다. 적어도 하나는 켜 두어야 합니다. 중국 본토에서는 Nominatim을 끄면 응답 시간 초과를 기다리지 않고 검색할 수 있습니다.</string>
    <string name="settings_menus_geocoding_nominatim">Nominatim (OpenStreetMap)</string>
    <string name="settings_menus_geocoding_photon">Photon (Komoot)</string>
    <string name="settings_menus_map_source">지도 제공자</string>
    <string name="settings_menus_map_source_osm">OpenStreetMap</string>
    <string name="settings_menus_map_source_amap">Amap (高德)</string>
    <string name="settings_menus_map_source_item">%1$s — %2$s</string>
    <string name="settings_menus_map_source_osm_default_city">프랑스 파리</string>
    <string name="settings_menus_map_source_amap_default_city">중국 베이징</string>
    <string name="settings_menus_map_source_amap_note">Amap 타일은 GCJ-02 좌표계를 사용합니다. 위치를 자동으로 변환해 마커, 경로, 지도 탭의 위치를 맞춥니다. 모든 데이터는 계속 WGS-84로 저장됩니다.</string>
    <string name="settings_menus_tap_to_walk">탭하여 걷기</string>
    <string name="settings_menus_walk_to_a_location_by_tapping">위치를 탭하면 확인 과정 없이 그곳으로 걸어갑니다.</string>
    <string name="settings_menus_menus">메뉴</string>
    <string name="settings_menus_map_scale_mpx">지도 축척 (%1$.2f m/px) — 대부분은 기본값으로 사용할 수 있습니다. 게임 지도를 최대한 축소한 뒤 위치가 맞지 않을 때만 조정하세요</string>
    <string name="settings_menus_enable_tap_to_walk">탭하여 걷기 켜기</string>
    <string name="settings_menus_enable_tap_to_walk_2">탭하여 걷기를 켤까요?</string>
    <string name="settings_menus_a_screen_overlay_that_intercepts_taps">탭을 가로채는 화면 오버레이는 일부 게임에서 감지될 가능성을 높일 수 있습니다. 이 점을 고려해 사용하세요.</string>
    <string name="settings_menus_accuracy_depends_on_the_scale_setting">정확도는 축척 설정에 따라 달라집니다. 게임 지도를 축소하면 더 잘 맞출 수 있습니다.</string>
    <string name="settings_menus_enable_anyway">그래도 켜기</string>
    <string name="common_cancel">취소</string>
    <string name="settings_menus_privacy">개인정보 보호</string>
    <string name="settings_menus_hide_teleport_features">순간 이동 기능 숨기기</string>
    <string name="settings_menus_hide_teleport_features_desc">지도, 즐겨찾기, 경로, 그룹 동기화, 위젯에서 모든 순간 이동 옵션을 숨깁니다. 걷기와 경로 재생만 사용할 수 있습니다.</string>
    <string name="settings_menus_floating_map_quick_walk">플로팅 지도에서 바로 걷기</string>
    <string name="settings_menus_floating_map_quick_walk_desc">플로팅 지도에서 위치를 탭하면 확인창 없이 바로 걸어갑니다.</string>
    <string name="settings_menus_hide_floating_widget">플로팅 위젯 숨기기</string>
    <string name="settings_menus_hide_floating_widget_desc">모의 위치 실행 중 플로팅 위젯 버튼을 표시하지 않습니다.</string>
    <string name="settings_menus_hide_notification_icon">알림 아이콘 숨기기</string>
    <string name="settings_menus_hide_notification_icon_desc">모의 위치 알림의 상태 표시줄 아이콘을 숨깁니다. Android에서 실행 알림은 유지해야 하므로 알림창에는 계속 표시됩니다.</string>
    <string name="settings_menus_show_route_jump_buttons">경로 지점 이동 버튼 표시</string>
    <string name="settings_menus_show_route_jump_buttons_desc">경로 재생 제어에 이전 지점·다음 지점 버튼을 추가해 지점 사이를 순간 이동할 수 있게 합니다. 기본값은 꺼짐입니다.</string>
    <string name="settings_menus_show_altitude_override_button">고도 지정 버튼 표시</string>
    <string name="settings_menus_show_altitude_override_button_desc">어느 화면에서든 고정 고도를 입력할 수 있도록 플로팅 위젯에 버튼을 추가합니다. 기본값은 꺼짐입니다.</string>
    <string name="settings_menus_capture">좌표 수집</string>
    <string name="settings_menus_capture_desc">다른 앱의 지도 링크를 목록에 모으거나, 해당 위치로 이동하거나, 두 작업을 함께 수행합니다. 좌표 수집 화면과 같은 설정입니다. geo:, google.navigation:, 앱으로 공유한 링크는 별도 설정 없이 항상 자동으로 처리됩니다.</string>
    <string name="settings_menus_capture_browser_automatic">자동</string>
    <string name="settings_menus_capture_launch_after">지도 링크 처리 후 열 앱: %1$s</string>
    <string name="settings_menus_capture_launch_after_none">없음</string>
    <string name="settings_menus_debug">디버그</string>
    <string name="settings_menus_debug_stats">디버그 정보</string>
    <string name="settings_menus_debug_stats_desc">모의 위치 실행 중 플로팅 위젯 패널에 현재 속도, 고도, 좌표, 갱신 빈도를 표시합니다.</string>
    <string name="settings_menus_compass_orientation">나침반 방향</string>
    <string name="settings_menus_when_enabled_the_app_detects_your">걷기를 시작하기 전에 게임의 나침반을 감지해 목적지 위치를 보정합니다. 대부분의 AR/GPS 게임처럼 오른쪽 위에 나침반이 있어야 하며 별도 보정 설정은 필요하지 않습니다. 접근성 서비스가 필요합니다. 일부 게임은 접근성 서비스를 감지할 수 있습니다.</string>
    <string name="settings_menus_accessibility_service">접근성 서비스</string>
    <string name="settings_menus_open_settings">설정 열기</string>
    <string name="settings_menus_game_app">게임 앱</string>
    <string name="settings_menus_compass_service_enabled">사용 중</string>
    <string name="settings_menus_compass_service_not_enabled">사용 안 함 — 탭하여 Android 설정 열기</string>
    <string name="settings_menus_select_app">앱 선택…</string>
    <string name="settings_menus_tap_test_to_switch_to">테스트를 누르면 %1$s 앱으로 전환해 나침반을 캡처한 뒤 이 화면으로 돌아옵니다.</string>
    <string name="settings_menus_select_the_game_above">위에서 게임을 선택하거나 직접 게임으로 전환한 뒤 테스트를 누르세요. 앱이 잠시 최소화되어 현재 화면을 캡처한 다음 돌아옵니다.</string>
    <string name="settings_menus_testing">테스트 중…</string>
    <string name="settings_menus_test">테스트</string>
    <string name="settings_menus_compass_detected">감지됨 — 화면 위쪽 기준 북쪽 방향은 %1$d°입니다</string>
    <string name="settings_menus_compass_not_detected">감지되지 않음 — 게임 나침반이 오른쪽 위에 보이는지 확인하세요</string>
    <string name="settings_menus_app_features">앱 기능</string>
